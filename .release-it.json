{
  "git": {
    "commitMessage": "chore(release): ${version}",
    "tagName": "v${version}",
    "tagAnnotation": "Release ${version}",
    "requireCommits": true,
    "push": true
  },
  "npm": {
    "publish": false
  },
  "github": {
    "release": false
  },
  "plugins": {
    "@csmith/release-it-calver-plugin": {
      "format": "YYYY.MM.MICRO",
      "increment": "calendar.micro"
    },
    "@release-it/conventional-changelog": {
      "preset": {
        "name": "angular"
      },
      "infile": "CHANGELOG.md",
      "header": "# Changelog"
    }
  }
}
